# Copy to .env and edit. Never commit .env (it is in .gitignore).
# Used by src.db (the SQL steps, `python -m src.semantic.sync_metrics`, `python -m src.mining.score`
# and the SQL tests). The pandas pipeline and the notebooks do not need it.

# Windows authentication (ODBC Driver 18 for SQL Server + pyodbc):
AGRIPULSE_SQL_CONN=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=AgriPulse;Trusted_Connection=yes;TrustServerCertificate=yes;

# SQL login instead:
# AGRIPULSE_SQL_CONN=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=AgriPulse;UID=your_user;PWD=your_password;TrustServerCertificate=yes;

# Or any SQLAlchemy URL, e.g. with pymssql (pip install pymssql), which needs no ODBC driver:
# AGRIPULSE_SQL_CONN=mssql+pymssql://your_user:your_password@localhost/AgriPulse
